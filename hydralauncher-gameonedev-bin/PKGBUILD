# Maintainer: aksharleo

pkgname=hydralauncher-gameonedev-bin
pkgver=4.1.3
_pkgver=${pkgver/_/-}
pkgrel=1
pkgdesc="Hydra Launcher (GameOneDev Fork) - An open-source gaming platform"
arch=('x86_64')
url="https://github.com/GameOneDev/hydra"
license=('MIT')
provides=("hydralauncher" "hydra-launcher")
conflicts=("hydralauncher" "hydralauncher-bin" "hydralauncher-git" "hydra-launcher" "hydra-launcher-bin")
replaces=("hydralauncher" "hydralauncher-bin" "hydralauncher-git" "hydra-launcher" "hydra-launcher-bin")
depends=('alsa-lib'
         'at-spi2-core'
         'bash'
         'cairo'
         'dbus'
         'expat'
         'gcc-libs'
         'gdk-pixbuf2'
         'glib2'
         'glibc'
         'gtk3'
         'hicolor-icon-theme'
         'libcups'
         'libdrm'
         'libx11'
         'libxcb'
         'libxcomposite'
         'libxdamage'
         'libxext'
         'libxfixes'
         'libxkbcommon'
         'libxrandr'
         'libxrender'
         'mesa'
         'nspr'
         'nss'
         'pango'
         'zlib')
options=('!strip')
source=("${url}/releases/download/v${_pkgver}/hydralauncher-${_pkgver}-linux-amd64.deb"
        "${pkgname}-LICENSE::${url}/raw/refs/tags/v${_pkgver}/LICENSE")
sha256sums=('1503b961f2a856ee2dc8dfc43a88597fd68a7b1c62531576ada78fbe5dfac192'
            '32619612c2e0223e86c4908747ec14bef64c3c423fee80910c1aa944769b66f9')

package() {
    bsdtar -xf data.tar.xz -C "${pkgdir}" --no-same-permissions
    
    install -d "${pkgdir}/usr/bin"
    ln -s "/opt/Hydra/hydralauncher" "${pkgdir}/usr/bin/hydralauncher"
    
    # Install license
    if [ -f "${srcdir}/${pkgname}-LICENSE" ]; then
        install -Dm644 "${srcdir}/${pkgname}-LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi
}
